# ---- アプリ ----
APP_HOST=127.0.0.1
APP_PORT=8080
# 既定: Windows は %ProgramData%\jenkins-scheduler、それ以外は ./var
# APP_DATA_DIR=C:\ProgramData\jenkins-scheduler
APP_TZ=Asia/Tokyo
# 両方設定すると Basic 認証が有効になる（APP_HOST=0.0.0.0 にする場合は必須）
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
# /metrics と /api/health を認証対象外にする（Prometheus 用）
APP_AUTH_EXEMPT_MONITORING=true
# HTTPS で待ち受ける場合（社内 CA の証明書）
# APP_TLS_CERT=C:\ProgramData\jenkins-scheduler\tls\server.crt
# APP_TLS_KEY=C:\ProgramData\jenkins-scheduler\tls\server.key
LOG_LEVEL=INFO

# 起動時に読み込む初期データ（任意）
# SEED_FILE=seed.toml

# ---- 認証 ----
#   shared_admin : ログインなしで閲覧と自由記入の編集ができ、共有の管理者アカウントでログインすると全操作できる
#   none         : 認証なし（127.0.0.1 での開発用。全員が全操作できる）
#   basic        : 上の APP_BASIC_AUTH_USER / PASSWORD の共有アカウント
#   ldap         : Active Directory でログインし、AD グループで権限を分ける（pip install -r requirements-ldap.txt が必要）
AUTH_MODE=shared_admin
# 共有の管理者アカウント（Jenkins を操作する人だけで共有する）
ADMIN_USERNAME=admin
# python -m app --hash-password で作った値を書く（平文の ADMIN_PASSWORD も使えるが非推奨）
ADMIN_PASSWORD_HASH=
SESSION_HOURS=10
# HTTPS で公開するときは自動で Cookie に Secure が付く（APP_TLS_CERT 設定時）

# ---- Active Directory（AUTH_MODE=ldap のときだけ。ldap3 は LGPL-3.0 なので社内審査が必要） ----
# ドメインコントローラー（カンマ区切りで複数可。先頭から順に試す）。LDAPS（636）を使う
# LDAP_URLS=ldaps://dc01.corp.local,ldaps://dc02.corp.local
# ユーザー名だけ入力されたときの補い方（どちらか）。yamada → yamada@corp.local
# LDAP_UPN_SUFFIX=corp.local
# LDAP_DOMAIN=CORP
# LDAP_BASE_DN=DC=corp,DC=local
# 社内 CA の証明書（未指定なら OS の証明書ストア）
# LDAP_CA_BUNDLE=C:\ProgramData\jenkins-scheduler\tls\corp-ca.pem
# 権限ごとの AD グループ。メールアドレス（メーリングリスト）・グループ名・DN のどれでも可。複数はカンマ区切り（DN は ; 区切り）
# どれにも入っていない人はログインできない。複数に入っていれば強い権限になる
# LDAP_ADMIN_GROUPS=jenkins-scheduler-admins@corp.local
# LDAP_MEMO_EDITOR_GROUPS=release-planners@corp.local
# LDAP_VIEWER_GROUPS=dev-all@corp.local
# 入れ子のグループ（グループの中のグループ）の人も対象にする
# LDAP_NESTED_GROUPS=true

# ---- Jenkins ----
JENKINS_URL=https://jenkins.example.local
JENKINS_USER=scheduler-bot
JENKINS_TOKEN=
# wincred にすると Windows 資格情報マネージャーから読む（.env に平文で置かない）。
# 登録は Windows 標準のコマンドで: cmdkey /generic:jenkins-scheduler /user:scheduler-bot /pass
JENKINS_TOKEN_SOURCE=env
# 社内 CA を PEM で直接指定する場合（未指定なら Windows の証明書ストアを使う）
# JENKINS_CA_BUNDLE=C:\ProgramData\jenkins-scheduler\tls\corp-ca.pem
# true にすると Jenkins に接続せず tests/fixtures/jenkins のモックを使う
JENKINS_MOCK=false

# ---- スケジューラ ----
DISPATCH_INTERVAL_SECONDS=30
RUN_HORIZON_DAYS=14
SCHEMA_POLL_MINUTES=5
TIMER_TRIGGER_LOOKBACK_DAYS=7

# ---- バックアップ ----
# 毎日 BACKUP_TIME（Asia/Tokyo）に DB のスナップショットと設定の JSON を取得し、BACKUP_KEEP 世代残す
BACKUP_ENABLED=true
BACKUP_TIME=01:30
BACKUP_KEEP=14
# バックアップの保存先。ディスク故障に備えるなら別ドライブや共有フォルダを指定する
#   例: BACKUP_DIR=D:\backup\jenkins-scheduler / BACKUP_DIR=\\fileserver\backup\jenkins-scheduler
#   相対パスはツールのフォルダ（.env がある場所）からの位置。空にすると <APP_DATA_DIR>\backups
BACKUP_DIR=C:\ProgramData\jenkins-scheduler\backups

# ---- 既定値（未確定事項 20章） ----
DEFAULT_OVERLAP_POLICY=skip
DEFAULT_MISSED_POLICY=run_late
DEFAULT_GRACE_MINUTES=10
