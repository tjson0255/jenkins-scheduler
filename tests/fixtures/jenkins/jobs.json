          "choices": [
            "debug",
            "release",
            "profile"
          ]
        },
        {
          "name": "RUN_TESTS",
          "type": "BooleanParameterDefinition",
          "description": "テストを実行する",
          "defaultParameterValue": {
            "value": true
          }
        },
        {
          "name": "VERSION",
          "type": "StringParameterDefinition",
          "description": "バージョン番号（空なら自動）",
