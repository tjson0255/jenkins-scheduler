# 初期データ（ビルドセット7つ等）。.env の SEED_FILE=seed.yaml で起動時に読み込むか、
#   python -m app --seed seed.yaml
# で投入する。job_path で突合するので何度実行しても重複しない。
categories:
  - name: ビルドセット
  - name: リリース関連
  - name: その他
targets:
  - {job_path: buildset/core-pipeline,    display_name: Core,    category: ビルドセット, color: "#4e79a7"}
  - {job_path: buildset/android-pipeline, display_name: Android, category: ビルドセット, color: "#59a14f"}
  - {job_path: buildset/ios-pipeline,     display_name: iOS,     category: ビルドセット, color: "#9c755f"}
  - {job_path: buildset/windows-pipeline, display_name: Windows, category: ビルドセット, color: "#f28e2b"}
  - {job_path: buildset/web-pipeline,     display_name: Web,     category: ビルドセット, color: "#e15759"}
  - {job_path: buildset/server-pipeline,  display_name: Server,  category: ビルドセット, color: "#76b7b2"}
  - {job_path: buildset/tools-pipeline,   display_name: Tools,   category: ビルドセット, color: "#b07aa1"}
  - {job_path: release/release-candidate, display_name: リリース候補ビルド, category: リリース関連, color: "#edc948"}
  - {job_path: release/store-submit,      display_name: ストア申請,       category: リリース関連}
  - {job_path: misc/nightly-report,       display_name: 夜間レポート,      category: その他, overlap_policy: queue}
